# Ignore scripts folder
scripts/
# …except the audit tool, which has to ship with the repo to be runnable at all. Git cannot
# re-include a file whose parent directory is excluded, so the directory is re-included and its
# contents excluded again — that keeps the thousands of scratch files under candidateSvgs/ out.
!_config/ui/scripts/
_config/ui/scripts/*
!_config/ui/scripts/audit*.mjs
# The audit report is an output, not a source: half a megabyte that changes wholesale on every run.
# Regenerate it with `npm run audit`; /audit says so when the file is absent.
_config/ui/public/data/audit.json
.DS_Store
node_modules
.vscode
.next
.claude
out
build
